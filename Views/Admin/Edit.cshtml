@model EventTicketSystem.Models.Event

<div class="container mt-5">

    <h2>Edit Event</h2>

    <form method="post" enctype="multipart/form-data">

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" />

        <div class="form-group mb-3">
            <label for="Title" class="form-label">Title</label>
            <input asp-for="Title" class="form-control" placeholder="Event title" required />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" placeholder="Event description" rows="4"
                      required></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label for="Location" class="form-label">Location</label>
            <input asp-for="Location" class="form-control" placeholder="Event location" required />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>

        <div class="form-row">
            <div class="form-group mb-3 col-md-6">
                <label for="Date" class="form-label">Date</label>
                <input asp-for="Date" class="form-control" type="date" required />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <div class="form-group mb-3 col-md-6">
                <label for="Time" class="form-label">Time</label>
                <input asp-for="Time" class="form-control" type="time" required />
                <span asp-validation-for="Time" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group mb-3">
            <label for="imageFile" class="form-label">Event Image</label>
            <input type="file" name="imageFile" id="imageFile" class="form-control" accept="image/*" />
            <small class="form-text text-muted">Upload a new image to replace the current one. Leave empty to keep the
                current image.</small>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mt-2">
                        <p><strong>Current Image:</strong></p>
                        <img src="@Model.ImageUrl" alt="Event image" style="max-width: 200px; height: auto; border-radius: 8px;"
                             onerror="this.src='/images/concert_banner.png'" />
                    </div>
                }
            </div>

            <div class="form-group mb-3">
                <label for="TicketCount" class="form-label">Available Tickets</label>
                <input asp-for="TicketCount" class="form-control" type="number" placeholder="Number of tickets" required />
                <span asp-validation-for="TicketCount" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label for="Category" class="form-label">Category</label>
                <select asp-for="Category" class="form-control" required>
                    <option value="">Select a category</option>
                    <option value="Theater" selected="@(Model.Category == "Theater" ? "selected" : "")">Theater</option>
                    <option value="Concert" selected="@(Model.Category == "Concert" ? "selected" : "")">Concert</option>
                    <option value="Cinema" selected="@(Model.Category == "Cinema" ? "selected" : "")">Cinema</option>
                    <option value="Festival" selected="@(Model.Category == "Festival" ? "selected" : "")">Festival</option>
                    <option value="Sports" selected="@(Model.Category == "Sports" ? "selected" : "")">Sports</option>
                </select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-pencil-square me-2"></i>Update Event
            </button>
            <a href="/Admin/Index" class="btn btn-secondary btn-lg">
                <i class="bi bi-x-circle me-2"></i>Cancel
            </a>

        </form>

    </div>

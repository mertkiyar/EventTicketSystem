@model EventTicketSystem.Models.Event

<div class="container mt-5">

    <h2>Create Event</h2>

    <form method="post">

        <input asp-for="Title" class="form-control mb-2" placeholder="Title" />
        <input asp-for="Description" class="form-control mb-2" placeholder="Description" />
        <input asp-for="Location" class="form-control mb-2" placeholder="Location" />
        <input asp-for="ImageUrl" class="form-control mb-2" placeholder="Image URL" />
        <input asp-for="TicketCount" class="form-control mb-2" placeholder="Tickets" />
        <input asp-for="Category" class="form-control mb-2" placeholder="Category" />

        <button class="btn btn-primary">
            Save
        </button>

    </form>

</div>
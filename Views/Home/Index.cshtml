@model List<EventTicketSystem.Models.Event>
@{
    ViewData["Title"] = "Home Page";

    // Filter database events by category
    var upcomingEvents = Model?.Where(e => e.Date.Date.Add(e.Time.ToTimeSpan()) >= DateTime.Now).OrderBy(e => e.Date).Take(6).ToList() ?? new List<EventTicketSystem.Models.Event>();
    var dbTheater = Model?.Where(e => e.Category != null && (e.Category.Contains("Theater",
StringComparison.OrdinalIgnoreCase) || e.Category.Contains("Tiyatro", StringComparison.OrdinalIgnoreCase))).ToList() ??
new List<EventTicketSystem.Models.Event>();
    var dbConcert = Model?.Where(e => e.Category != null && (e.Category.Contains("Concert",
StringComparison.OrdinalIgnoreCase) || e.Category.Contains("Konser", StringComparison.OrdinalIgnoreCase))).ToList() ??
new List<EventTicketSystem.Models.Event>();
    var dbCinema = Model?.Where(e => e.Category != null && (e.Category.Contains("Cinema",
StringComparison.OrdinalIgnoreCase) || e.Category.Contains("Sinema", StringComparison.OrdinalIgnoreCase))).ToList() ??
new List<EventTicketSystem.Models.Event>();
    var dbFestival = Model?.Where(e => e.Category != null && e.Category.Contains("Festival",
StringComparison.OrdinalIgnoreCase)).ToList() ?? new List<EventTicketSystem.Models.Event>();
    var dbSports = Model?.Where(e => e.Category != null && (e.Category.Contains("Sports",
StringComparison.OrdinalIgnoreCase) || e.Category.Contains("Spor", StringComparison.OrdinalIgnoreCase))).ToList() ?? new
List<EventTicketSystem.Models.Event>();
}

<div class="container mt-4">
    <!-- Hero Slider / Carousel -->
    <div id="eventCarousel" class="carousel slide carousel-fade shadow-sm rounded-4 overflow-hidden mb-5"
         data-bs-ride="carousel">
        <!-- Indicators -->
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#eventCarousel" data-bs-slide-to="0" class="active"
                    aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#eventCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#eventCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
            <button type="button" data-bs-target="#eventCarousel" data-bs-slide-to="3" aria-label="Slide 4"></button>
            <button type="button" data-bs-target="#eventCarousel" data-bs-slide-to="4" aria-label="Slide 5"></button>
        </div>

        <!-- Slides -->
        <div class="carousel-inner">
            <!-- Slide 1: Concert -->
            <div class="carousel-item active" data-bs-interval="5000">
                <img src="~/images/concert_banner.png" class="d-block w-100" alt="Live Concerts">
                <div class="carousel-caption text-start">
                    <div class="container px-0 px-md-4">
                        <span class="badge bg-danger mb-2 px-3 py-2 rounded-pill text-uppercase"
                              style="letter-spacing: 1px; font-weight: 700;">Live & Loud</span>
                        <h2 class="display-5 fw-bold text-white mb-2">Feel the Rhythm of the Night</h2>
                        <p class="lead text-light mb-4 d-none d-sm-block">Book exclusive tickets for the hottest live
                            music events and international artists.</p>
                            <a href="/Events/Concert" class="btn btn-light rounded-pill px-4 py-2 fw-bold shadow-sm">Explore
                                Concerts</a>
                            </div>
                        </div>
                    </div>

                    <!-- Slide 2: Theater -->
                    <div class="carousel-item" data-bs-interval="5000">
                        <img src="~/images/theater_banner.png" class="d-block w-100" alt="Theatre Plays">
                        <div class="carousel-caption text-start">
                            <div class="container px-0 px-md-4">
                                <span class="badge bg-warning text-dark mb-2 px-3 py-2 rounded-pill text-uppercase"
                                      style="letter-spacing: 1px; font-weight: 700;">Classic & Modern</span>
                                <h2 class="display-5 fw-bold text-white mb-2">Experience Majestic Theater</h2>
                                <p class="lead text-light mb-4 d-none d-sm-block">From classic tragedies to modern Broadway
                                    hits, reserve your stage front seats today.</p>
                                    <a href="/Events/Theater"
                                       class="btn btn-warning rounded-pill px-4 py-2 fw-bold shadow-sm text-dark">Explore
                                        Theater</a>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 3: Sports -->
                            <div class="carousel-item" data-bs-interval="5000">
                                <img src="~/images/sports_banner.png" class="d-block w-100" alt="Sports Events">
                                <div class="carousel-caption text-start">
                                    <div class="container px-0 px-md-4">
                                        <span class="badge bg-success mb-2 px-3 py-2 rounded-pill text-uppercase"
                                              style="letter-spacing: 1px; font-weight: 700;">Passionate Matches</span>
                                        <h2 class="display-5 fw-bold text-white mb-2">Be Part of the Game</h2>
                                        <p class="lead text-light mb-4 d-none d-sm-block">Don't miss the thrill! Get your match day
                                            tickets and support your favorite team live.</p>
                                            <a href="/Events/Sports"
                                               class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm text-white">Explore
                                                Sports</a>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Slide 4: Cinema -->
                                    <div class="carousel-item" data-bs-interval="5000">
                                        <img src="~/images/cinema_banner.png" class="d-block w-100" alt="Cinema & Movies">
                                        <div class="carousel-caption text-start">
                                            <div class="container px-0 px-md-4">
                                                <span class="badge bg-info text-dark mb-2 px-3 py-2 rounded-pill text-uppercase"
                                                      style="letter-spacing: 1px; font-weight: 700;">Big Screen</span>
                                                <h2 class="display-5 fw-bold text-white mb-2">Cinema Under the Stars</h2>
                                                <p class="lead text-light mb-4 d-none d-sm-block">Discover the latest blockbusters and art-house
                                                    films. Reserve your seat for an unforgettable experience.</p>
                                                    <a href="/Events/Cinema"
                                                       class="btn btn-info rounded-pill px-4 py-2 fw-bold shadow-sm text-dark">Explore Cinema</a>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Slide 5: Festival -->
                                        <div class="carousel-item" data-bs-interval="5000">
                                            <img src="~/images/festival_banner.png" class="d-block w-100" alt="Festivals">
                                            <div class="carousel-caption text-start">
                                                <div class="container px-0 px-md-4">
                                                    <span class="badge bg-secondary mb-2 px-3 py-2 rounded-pill text-uppercase"
                                                          style="letter-spacing: 1px; font-weight: 700;">Celebrate Life</span>
                                                    <h2 class="display-5 fw-bold text-white mb-2">Join the Festival Fever</h2>
                                                    <p class="lead text-light mb-4 d-none d-sm-block">Music, art, food and culture — dive into the
                                                        most vibrant festivals of the year.</p>
                                                        <a href="/Events/Festival"
                                                           class="btn btn-light rounded-pill px-4 py-2 fw-bold shadow-sm">Explore Festivals</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Controls -->
                                        <button class="carousel-control-prev" type="button" data-bs-target="#eventCarousel" data-bs-slide="prev">
                                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                            <span class="visually-hidden">Previous</span>
                                        </button>
                                        <button class="carousel-control-next" type="button" data-bs-target="#eventCarousel" data-bs-slide="next">
                                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                            <span class="visually-hidden">Next</span>
                                        </button>
                                    </div>

                                    <!-- 1. Upcoming Events Section -->
                                    <div id="upcoming-section" class="mb-5">
                                        <div class="section-header">
                                            <h2 class="section-title">Upcoming Events</h2>
                                            <a href="#category-navbar" class="see-all-link">See All ➔</a>
                                        </div>
                                        <div class="event-scroll-container">
                                            @if (upcomingEvents.Any())
                                            {
                                                @foreach (var ev in upcomingEvents)
                                                {
                                                    var isPast = ev.Date.Date.Add(ev.Time.ToTimeSpan()) < DateTime.Now || ev.TicketCount <= 0;
                                                    <div class="event-card @(isPast ? "past-event" : "")">
                                                        <div class="event-card-img-wrapper">
                                                            <span class="event-card-badge bg-primary text-white">@ev.Category</span>
                                                            <img class="event-card-img" src="@ev.ImageUrl" alt="@ev.Title"
                                                                 onerror="this.src='/images/concert_banner.png'">
                                                        </div>
                                                        <div class="event-card-body">
                                                            <h3 class="event-card-title">@ev.Title</h3>
                                                            <div class="event-card-info">
                                                                <i class="bi bi-geo-alt event-card-info-icon me-1"></i> @ev.Location
                                                            </div>
                                                            <div class="event-card-info">
                                                                <i class="bi bi-calendar3 event-card-info-icon me-1"></i> @ev.Date.ToString("dd MMM yyyy")
                                                            </div>
                                                            <div class="event-card-footer">
                                                                <span class="text-muted" style="font-size: 0.85rem; font-weight: 500;"><i
                                                                    class="bi bi-ticket-perforated-fill me-1"></i> @ev.TicketCount left</span>
                                                                    <button type="button" onclick="handleDetailsClick(@ev.Id)"
                                                                            class="btn btn-dark event-card-btn">Details</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                }
            else
                                                {
                                                    <p class="text-muted ps-2 py-3">No upcoming events scheduled at the moment.</p>
                                                }
                                            </div>
                                        </div>

                                        <!-- 2. Theater Section -->
                                        <div id="theater-section" class="mb-5">
                                            <div class="section-header">
                                                <h2 class="section-title">Theater Plays</h2>
                                                <a href="/Events/Theater" class="see-all-link">See All ➔</a>
                                            </div>
                                            <div class="event-scroll-container">
                                                @if (dbTheater.Any())
                                                {
                                                    @foreach (var ev in dbTheater)
                                                    {
                                                        var isPast = ev.Date.Date.Add(ev.Time.ToTimeSpan()) < DateTime.Now || ev.TicketCount <= 0;
                                                        <div class="event-card @(isPast ? "past-event" : "")">
                                                            <div class="event-card-img-wrapper">
                                                                <span class="event-card-badge bg-warning text-dark">Theater</span>
                                                                <img class="event-card-img" src="@ev.ImageUrl" alt="@ev.Title"
                                                                     onerror="this.src='/images/theater_banner.png'">
                                                            </div>
                                                            <div class="event-card-body">
                                                                <h3 class="event-card-title">@ev.Title</h3>
                                                                <div class="event-card-info">
                                                                    <i class="bi bi-geo-alt event-card-info-icon me-1"></i> @ev.Location
                                                                </div>
                                                                <div class="event-card-info">
                                                                    <i class="bi bi-calendar3 event-card-info-icon me-1"></i> @ev.Date.ToString("dd MMM yyyy")
                                                                </div>
                                                                <div class="event-card-footer">
                                                                    <span class="text-muted" style="font-size: 0.85rem; font-weight: 500;"><i
                                                                        class="bi bi-ticket-perforated-fill me-1"></i> @ev.TicketCount left</span>
                                                                        <button type="button" onclick="handleDetailsClick(@ev.Id)"
                                                                                class="btn btn-warning event-card-btn text-dark">Details</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
            else
                                                    {
                                                        <p class="text-muted ps-2 py-3">No theater plays scheduled at the moment.</p>
                                                    }
                                                </div>
                                            </div>

                                            <!-- 3. Concert Section -->
                                            <div id="concert-section" class="mb-5">
                                                <div class="section-header">
                                                    <h2 class="section-title">Concerts</h2>
                                                    <a href="/Events/Concert" class="see-all-link">See All ➔</a>
                                                </div>
                                                <div class="event-scroll-container">
                                                    @if (dbConcert.Any())
                                                    {
                                                        @foreach (var ev in dbConcert)
                                                        {
                                                            var isPast = ev.Date.Date.Add(ev.Time.ToTimeSpan()) < DateTime.Now || ev.TicketCount <= 0;
                                                            <div class="event-card @(isPast ? "past-event" : "")">
                                                                <div class="event-card-img-wrapper">
                                                                    <span class="event-card-badge bg-danger text-white">Concert</span>
                                                                    <img class="event-card-img" src="@ev.ImageUrl" alt="@ev.Title"
                                                                         onerror="this.src='/images/concert_banner.png'">
                                                                </div>
                                                                <div class="event-card-body">
                                                                    <h3 class="event-card-title">@ev.Title</h3>
                                                                    <div class="event-card-info">
                                                                        <i class="bi bi-geo-alt event-card-info-icon me-1"></i> @ev.Location
                                                                    </div>
                                                                    <div class="event-card-info">
                                                                        <i class="bi bi-calendar3 event-card-info-icon me-1"></i> @ev.Date.ToString("dd MMM yyyy")
                                                                    </div>
                                                                    <div class="event-card-footer">
                                                                        <span class="text-muted" style="font-size: 0.85rem; font-weight: 500;"><i
                                                                            class="bi bi-ticket-perforated-fill me-1"></i> @ev.TicketCount left</span>
                                                                            <button type="button" onclick="handleDetailsClick(@ev.Id)"
                                                                                    class="btn btn-danger event-card-btn">Details</button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }
                                                        }
            else
                                                        {
                                                            <p class="text-muted ps-2 py-3">No concerts scheduled at the moment.</p>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- 4. Cinema Section -->
                                                <div id="cinema-section" class="mb-5">
                                                    <div class="section-header">
                                                        <h2 class="section-title">Cinema & Movies</h2>
                                                        <a href="/Events/Cinema" class="see-all-link">See All ➔</a>
                                                    </div>
                                                    <div class="event-scroll-container">
                                                        @if (dbCinema.Any())
                                                        {
                                                            @foreach (var ev in dbCinema)
                                                            {
                                                                var isPast = ev.Date.Date.Add(ev.Time.ToTimeSpan()) < DateTime.Now || ev.TicketCount <= 0;
                                                                <div class="event-card @(isPast ? "past-event" : "")">
                                                                    <div class="event-card-img-wrapper">
                                                                        <span class="event-card-badge bg-info text-dark">Cinema</span>
                                                                        <img class="event-card-img" src="@ev.ImageUrl" alt="@ev.Title"
                                                                             onerror="this.src='/images/cinema_banner.png'">
                                                                    </div>
                                                                    <div class="event-card-body">
                                                                        <h3 class="event-card-title">@ev.Title</h3>
                                                                        <div class="event-card-info">
                                                                            <i class="bi bi-geo-alt event-card-info-icon me-1"></i> @ev.Location
                                                                        </div>
                                                                        <div class="event-card-info">
                                                                            <i class="bi bi-calendar3 event-card-info-icon me-1"></i> @ev.Date.ToString("dd MMM yyyy")
                                                                        </div>
                                                                        <div class="event-card-footer">
                                                                            <span class="text-muted" style="font-size: 0.85rem; font-weight: 500;"><i
                                                                                class="bi bi-ticket-perforated-fill me-1"></i> @ev.TicketCount left</span>
                                                                                <button type="button" onclick="handleDetailsClick(@ev.Id)"
                                                                                        class="btn btn-info event-card-btn text-dark">Details</button>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            }
            else
                                                            {
                                                                <p class="text-muted ps-2 py-3">No cinema screenings scheduled at the moment.</p>
                                                            }
                                                        </div>
                                                    </div>

                                                    <!-- 5. Festival Section -->
                                                    <div id="festival-section" class="mb-5">
                                                        <div class="section-header">
                                                            <h2 class="section-title">Festivals</h2>
                                                            <a href="/Events/Festival" class="see-all-link">See All ➔</a>
                                                        </div>
                                                        <div class="event-scroll-container">
                                                            @if (dbFestival.Any())
                                                            {
                                                                @foreach (var ev in dbFestival)
                                                                {
                                                                    var isPast = ev.Date.Date.Add(ev.Time.ToTimeSpan()) < DateTime.Now || ev.TicketCount <= 0;
                                                                    <div class="event-card @(isPast ? "past-event" : "")">
                                                                        <div class="event-card-img-wrapper">
                                                                            <span class="event-card-badge bg-secondary text-white">Festival</span>
                                                                            <img class="event-card-img" src="@ev.ImageUrl" alt="@ev.Title"
                                                                                 onerror="this.src='/images/festival_banner.png'">
                                                                        </div>
                                                                        <div class="event-card-body">
                                                                            <h3 class="event-card-title">@ev.Title</h3>
                                                                            <div class="event-card-info">
                                                                                <i class="bi bi-geo-alt event-card-info-icon me-1"></i> @ev.Location
                                                                            </div>
                                                                            <div class="event-card-info">
                                                                                <i class="bi bi-calendar3 event-card-info-icon me-1"></i> @ev.Date.ToString("dd MMM yyyy")
                                                                            </div>
                                                                            <div class="event-card-footer">
                                                                                <span class="text-muted" style="font-size: 0.85rem; font-weight: 500;"><i
                                                                                    class="bi bi-ticket-perforated-fill me-1"></i> @ev.TicketCount left</span>
                                                                                    <button type="button" onclick="handleDetailsClick(@ev.Id)"
                                                                                            class="btn btn-secondary event-card-btn text-white">Details</button>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                }
            else
                                                                {
                                                                    <p class="text-muted ps-2 py-3">No festivals scheduled at the moment.</p>
                                                                }
                                                            </div>
                                                        </div>

                                                        <!-- 6. Sports Section -->
                                                        <div id="sports-section" class="mb-5">
                                                            <div class="section-header">
                                                                <h2 class="section-title">Sports</h2>
                                                                <a href="/Events/Sports" class="see-all-link">See All ➔</a>
                                                            </div>
                                                            <div class="event-scroll-container">
                                                                @if (dbSports.Any())
                                                                {
                                                                    @foreach (var ev in dbSports)
                                                                    {
                                                                        var isPast = ev.Date.Date.Add(ev.Time.ToTimeSpan()) < DateTime.Now || ev.TicketCount <= 0;
                                                                        <div class="event-card @(isPast ? "past-event" : "")">
                                                                            <div class="event-card-img-wrapper">
                                                                                <span class="event-card-badge bg-success text-white">Sports</span>
                                                                                <img class="event-card-img" src="@ev.ImageUrl" alt="@ev.Title"
                                                                                     onerror="this.src='/images/sports_banner.png'">
                                                                            </div>
                                                                            <div class="event-card-body">
                                                                                <h3 class="event-card-title">@ev.Title</h3>
                                                                                <div class="event-card-info">
                                                                                    <i class="bi bi-geo-alt event-card-info-icon me-1"></i> @ev.Location
                                                                                </div>
                                                                                <div class="event-card-info">
                                                                                    <i class="bi bi-calendar3 event-card-info-icon me-1"></i> @ev.Date.ToString("dd MMM yyyy")
                                                                                </div>
                                                                                <div class="event-card-footer">
                                                                                    <span class="text-muted" style="font-size: 0.85rem; font-weight: 500;"><i
                                                                                        class="bi bi-ticket-perforated-fill me-1"></i> @ev.TicketCount left</span>
                                                                                        <button type="button" onclick="handleDetailsClick(@ev.Id)"
                                                                                                class="btn btn-success event-card-btn text-white">Details</button>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    }
            else
                                                                    {
                                                                        <p class="text-muted ps-2 py-3">No sports events scheduled at the moment.</p>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>

@model List<EventTicketSystem.Models.Event>
@{
    ViewData["Title"] = "Home Page";

    // Filter database events by category
    var upcomingEvents = Model?.OrderBy(e => e.Date).Take(6).ToList() ?? new List<EventTicketSystem.Models.Event>();
    var dbTheater = Model?.Where(e => e.Category != null && (e.Category.Contains("Theater", StringComparison.OrdinalIgnoreCase) || e.Category.Contains("Tiyatro", StringComparison.OrdinalIgnoreCase))).ToList() ?? new List<EventTicketSystem.Models.Event>();
    var dbConcert = Model?.Where(e => e.Category != null && (e.Category.Contains("Concert", StringComparison.OrdinalIgnoreCase) || e.Category.Contains("Konser", StringComparison.OrdinalIgnoreCase))).ToList() ?? new List<EventTicketSystem.Models.Event>();
    var dbCinema = Model?.Where(e => e.Category != null && (e.Category.Contains("Cinema", StringComparison.OrdinalIgnoreCase) || e.Category.Contains("Sinema", StringComparison.OrdinalIgnoreCase))).ToList() ?? new List<EventTicketSystem.Models.Event>();
    var dbFestival = Model?.Where(e => e.Category != null && e.Category.Contains("Festival", StringComparison.OrdinalIgnoreCase)).ToList() ?? new List<EventTicketSystem.Models.Event>();
    var dbSports = Model?.Where(e => e.Category != null && (e.Category.Contains("Sports", StringComparison.OrdinalIgnoreCase) || e.Category.Contains("Spor", StringComparison.OrdinalIgnoreCase))).ToList() ?? new List<EventTicketSystem.Models.Event>();
}

@section Navbar {
    <div id="category-navbar" class="category-navbar py-2 border-bottom">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <!-- Left empty element to balance centering on desktop -->
            <div style="width: 170px;" class="d-none d-lg-block"></div>

            <ul class="nav category-nav-list justify-content-center">
                <li class="nav-item">
                    <a class="category-nav-link active" href="#eventCarousel">Mainpage</a>
                </li>
                <li class="nav-item">
                    <a class="category-nav-link" href="#theater-section">Theater</a>
                </li>
                <li class="nav-item">
                    <a class="category-nav-link" href="#concert-section">Concert</a>
                </li>
                <li class="nav-item">
                    <a class="category-nav-link" href="#cinema-section">Cinema</a>
                </li>
                <li class="nav-item">
                    <a class="category-nav-link" href="#festival-section">Festival</a>
                </li>
                <li class="nav-item">
                    <a class="category-nav-link" href="#sports-section">Sports</a>
                </li>
            </ul>

            <div class="auth-buttons d-flex gap-3 align-items-center justify-content-end" style="min-width: 200px;">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">
                        <a href="javascript:void(0)" class="d-flex align-items-center text-decoration-none dropdown-toggle" id="profileDropdown" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                            <img src="~/images/default_avatar.png" alt="Profile" class="rounded-circle border" style="width: 38px; height: 38px; object-fit: cover; margin-right: 8px;">
                            <span class="text-dark fw-bold" style="font-size: 0.9rem;">@User.Identity.Name</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2" aria-labelledby="profileDropdown">
                            <li class="px-3 py-2 border-bottom">
                                <span class="d-block text-muted" style="font-size: 0.75rem;">Signed in as</span>
                                <span class="d-block fw-bold text-dark" style="font-size: 0.85rem;">@User.Identity.Name</span>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center" asp-controller="Events" asp-action="MyTickets">
                                    <i class="bi bi-ticket-perforated me-2"></i> My Tickets
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit" class="dropdown-item text-danger py-2 d-flex align-items-center" style="border: none; background: none; width: 100%; text-align: left; font-weight: 500;">
                                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="javascript:void(0)" onclick="openAuthModal('login')" class="btn btn-outline-dark auth-btn">Login</a>
                    <a href="javascript:void(0)" onclick="openAuthModal('register')" class="btn btn-dark auth-btn">Register</a>
                }
            </div>
        </div>
    </div>
}

<div class="container mt-4">
    <!-- Hero Slider / Carousel -->
    <div id="eventCarousel" class="carousel slide carousel-fade shadow-sm rounded-4 overflow-hidden mb-5" data-bs-ride="carousel">
        <!-- Indicators -->
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#eventCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#eventCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#eventCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>

        <!-- Slides -->
        <div class="carousel-inner">
            <!-- Slide 1: Concert -->
            <div class="carousel-item active" data-bs-interval="5000">
                <img src="~/images/concert_banner.png" class="d-block w-100" alt="Live Concerts">
                <div class="carousel-caption text-start">
                    <div class="container px-0 px-md-4">
                        <span class="badge bg-danger mb-2 px-3 py-2 rounded-pill text-uppercase" style="letter-spacing: 1px; font-weight: 700;">Live & Loud</span>
                        <h2 class="display-5 fw-bold text-white mb-2">Feel the Rhythm of the Night</h2>
                        <p class="lead text-light mb-4 d-none d-sm-block">Book exclusive tickets for the hottest live music events and international artists.</p>
                        <a href="#concert-section" class="btn btn-light rounded-pill px-4 py-2 fw-bold shadow-sm">Explore Concerts</a>
                    </div>
                </div>
            </div>

            <!-- Slide 2: Theater -->
            <div class="carousel-item" data-bs-interval="5000">
                <img src="~/images/theater_banner.png" class="d-block w-100" alt="Theatre Plays">
                <div class="carousel-caption text-start">
                    <div class="container px-0 px-md-4">
                        <span class="badge bg-warning text-dark mb-2 px-3 py-2 rounded-pill text-uppercase" style="letter-spacing: 1px; font-weight: 700;">Classic & Modern</span>
                        <h2 class="display-5 fw-bold text-white mb-2">Experience Majestic Theater</h2>
                        <p class="lead text-light mb-4 d-none d-sm-block">From classic tragedies to modern Broadway hits, reserve your stage front seats today.</p>
                        <a href="#theater-section" class="btn btn-warning rounded-pill px-4 py-2 fw-bold shadow-sm text-dark">Explore Theater</a>
                    </div>
                </div>
            </div>

            <!-- Slide 3: Sports -->
            <div class="carousel-item" data-bs-interval="5000">
                <img src="~/images/sports_banner.png" class="d-block w-100" alt="Sports Events">
                <div class="carousel-caption text-start">
                    <div class="container px-0 px-md-4">
                        <span class="badge bg-success mb-2 px-3 py-2 rounded-pill text-uppercase" style="letter-spacing: 1px; font-weight: 700;">Passionate Matches</span>
                        <h2 class="display-5 fw-bold text-white mb-2">Be Part of the Game</h2>
                        <p class="lead text-light mb-4 d-none d-sm-block">Don't miss the thrill! Get your match day tickets and support your favorite team live.</p>
                        <a href="#sports-section" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm text-white">Explore Sports</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Controls -->
        <button class="carousel-control-prev" type="button" data-bs-target="#eventCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#eventCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

    <!-- 1. Upcoming Events Section -->
    <div id="upcoming-section" class="mb-5">
        <div class="section-header">
            <h2 class="section-title">Upcoming Events</h2>
            <a href="#category-navbar" class="see-all-link">See All ➔</a>
        </div>
        <div class="event-scroll-container">
            @if (upcomingEvents.Any())
            {
                @foreach (var ev in upcomingEvents)
                {
                    <div class="event-card">
                        <div class="event-card-img-wrapper">
                            <span class="event-card-badge bg-primary text-white">@ev.Category</span>
                            <img class="event-card-img" src="@ev.ImageUrl" alt="@ev.Title" onerror="this.src='/images/concert_banner.png'">
                        </div>
                        <div class="event-card-body">
                            <h3 class="event-card-title">@ev.Title</h3>
                            <div class="event-card-info">
                                <i class="bi bi-geo-alt event-card-info-icon me-1"></i> @ev.Location
                            </div>
                            <div class="event-card-info">
                                <i class="bi bi-calendar3 event-card-info-icon me-1"></i> @ev.Date.ToString("dd MMM yyyy")
                            </div>
                            <div class="event-card-footer">
                                <span class="text-muted" style="font-size: 0.85rem; font-weight: 500;"><i class="bi bi-ticket-perforated-fill me-1"></i> @ev.TicketCount left</span>
                                <button type="button" onclick="handleDetailsClick(@ev.Id)" class="btn btn-dark event-card-btn">Details</button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted ps-2 py-3">No upcoming events scheduled at the moment.</p>
            }
        </div>
    </div>

    <!-- 2. Theater Section -->
    <div id="theater-section" class="mb-5">

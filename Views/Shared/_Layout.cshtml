<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventTicketSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EventTicketSystem.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <header>
        @{
            string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
            string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
        }
        <div id="category-navbar" class="category-navbar py-2 border-bottom">
            <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
                <!-- Left empty element to balance centering on desktop -->
                <div style="width: 170px;" class="d-none d-lg-block"></div>

                <ul class="nav category-nav-list justify-content-center">
                    <li class="nav-item">
                        <a class="category-nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                           href="/">Mainpage</a>
                    </li>
                    <li class="nav-item">
                        <a class="category-nav-link @(currentController == "Events" && currentAction == "Theater" ? "active" : "")"
                           href="/Events/Theater">Theater</a>
                    </li>
                    <li class="nav-item">
                        <a class="category-nav-link @(currentController == "Events" && currentAction == "Concert" ? "active" : "")"
                           href="/Events/Concert">Concert</a>
                    </li>
                    <li class="nav-item">
                        <a class="category-nav-link @(currentController == "Events" && currentAction == "Cinema" ? "active" : "")"
                           href="/Events/Cinema">Cinema</a>
                    </li>
                    <li class="nav-item">
                        <a class="category-nav-link @(currentController == "Events" && currentAction == "Festival" ? "active" : "")"
                           href="/Events/Festival">Festival</a>
                    </li>
                    <li class="nav-item">
                        <a class="category-nav-link @(currentController == "Events" && currentAction == "Sports" ? "active" : "")"
                           href="/Events/Sports">Sports</a>
                    </li>
                </ul>

                <div class="auth-buttons d-flex gap-3 align-items-center justify-content-end" style="min-width: 200px;">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="dropdown">
                            <a href="javascript:void(0)"
                               class="d-flex align-items-center text-decoration-none dropdown-toggle" id="profileDropdown"
                               data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                                <img src="~/images/default_avatar.png" alt="Profile" class="rounded-circle border"
                                     style="width: 38px; height: 38px; object-fit: cover; margin-right: 8px;">
                                <span class="text-dark fw-bold" style="font-size: 0.9rem;">@User.Identity.Name</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2"
                                aria-labelledby="profileDropdown">
                                <li class="px-3 py-2 border-bottom">
                                    <span class="d-block text-muted" style="font-size: 0.75rem;">Signed in as</span>
                                    <span class="d-block fw-bold text-dark"
                                          style="font-size: 0.85rem;">@User.Identity.Name</span>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center" asp-controller="Events"
                                       asp-action="MyTickets">
                                        <i class="bi bi-ticket-perforated me-2"></i> My Tickets
                                    </a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit"
                                                class="dropdown-item text-danger py-2 d-flex align-items-center"
                                                style="border: none; background: none; width: 100%; text-align: left; font-weight: 500;">
                                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="javascript:void(0)" onclick="openAuthModal('login')"
                           class="btn btn-outline-dark auth-btn">Login</a>
                        <a href="javascript:void(0)" onclick="openAuthModal('register')"
                           class="btn btn-dark auth-btn">Register</a>
                    }
                </div>
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <!-- Auth Modal Container -->
    <div class="auth-overlay" id="authOverlay" onclick="if(event.target === this) closeAuthModal()">
        <div class="auth-card">
            <button type="button" class="auth-close-btn" onclick="closeAuthModal()">✕</button>
            <div class="auth-slider-container">
                <div class="auth-slider" id="authSlider">
                    <!-- Login Form -->
                    <div class="auth-form-side">
                        <h2 class="auth-form-title">Welcome Back</h2>
                        <div class="alert alert-danger py-2 px-3 mb-3 rounded-3" id="loginError"
                             style="display: none; font-size: 0.85rem; text-align: left;"></div>
                        <form onsubmit="handleLogin(event)">
                            <div class="auth-input-group">
                                <label class="auth-label">Email Address</label>
                                <input type="email" id="loginEmail" class="auth-input" placeholder="name@example.com"
                                       required>
                            </div>
                            <div class="auth-input-group">
                                <label class="auth-label">Password</label>
                                <input type="password" id="loginPassword" class="auth-input"
                                       placeholder="Enter your password" required>
                            </div>
                            <button type="submit" class="auth-submit-btn">Sign In</button>
                            <p class="auth-switch-text">
                                Don't have an account?
                                <a href="javascript:void(0)" class="auth-switch-link"
                                   onclick="switchAuthMode('register')">Sign Up</a>
                            </p>
                        </form>
                    </div>

                    <!-- Register Form -->
                    <div class="auth-form-side">
                        <h2 class="auth-form-title">Create Account</h2>
                        <div class="alert alert-danger py-2 px-3 mb-3 rounded-3" id="registerError"
                             style="display: none; font-size: 0.85rem; text-align: left;"></div>
                        <form onsubmit="handleRegister(event)">
                            <div class="auth-input-group">
                                <label class="auth-label">Full Name</label>
                                <input type="text" id="registerName" class="auth-input" placeholder="John Doe" required>
                            </div>
                            <div class="auth-input-group">
                                <label class="auth-label">Email Address</label>
                                <input type="email" id="registerEmail" class="auth-input" placeholder="name@example.com"
                                       required>
                            </div>
                            <div class="auth-input-group">
                                <label class="auth-label">Password</label>
                                <input type="password" id="registerPassword" class="auth-input"
                                       placeholder="Create a password" required>
                            </div>
                            <button type="submit" class="auth-submit-btn">Sign Up</button>
                            <p class="auth-switch-text">
                                Already have an account?
                                <a href="javascript:void(0)" class="auth-switch-link"
                                   onclick="switchAuthMode('login')">Sign In</a>
                            </p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Event Details Modal -->
    <div class="event-details-overlay" id="eventDetailsOverlay"
         onclick="if(event.target === this) closeEventDetailsModal()">
        <div class="event-details-card" id="eventDetailsCard">
            <button type="button" class="auth-close-btn" onclick="closeEventDetailsModal()">✕</button>
            <!-- Content will be injected here -->
            <div id="eventDetailsContent">
                <div class="event-details-loading">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // ===== Auth Modal =====
        var _pendingEventId = null;

        function openAuthModal(mode, eventId) {
        _pendingEventId = eventId || null;
        const overlay = document.getElementById('authOverlay');
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
        switchAuthMode(mode);
        }

        function closeAuthModal() {
        const overlay = document.getElementById('authOverlay');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
        document.getElementById('loginError').style.display = 'none';
        document.getElementById('registerError').style.display = 'none';
        }

        function switchAuthMode(mode) {
        const slider = document.getElementById('authSlider');
        if (mode === 'register') {
        slider.style.transform = 'translateX(-50%)';
        } else {
        slider.style.transform = 'translateX(0)';
        }
        }

        async function handleLogin(e) {
        e.preventDefault();
        const email = document.getElementById('loginEmail').value;
        const password = document.getElementById('loginPassword').value;
        const errorDiv = document.getElementById('loginError');
        errorDiv.style.display = 'none';

        const formData = new FormData();
        formData.append('email', email);
        formData.append('password', password);

        try {
        const response = await fetch('/Account/Login', {
        method: 'POST',
        body: formData
        });
        const result = await response.json();
        if (result.success) {
        closeAuthModal();
        if (_pendingEventId) {
        // Open event details after login
        openEventDetailsModal(_pendingEventId);
        _pendingEventId = null;
        } else {
        window.location.reload();
        }
        } else {
        errorDiv.innerText = result.message;
        errorDiv.style.display = 'block';
        }
        } catch (err) {
        errorDiv.innerText = 'An error occurred. Please try again.';
        errorDiv.style.display = 'block';
        }
        }

        async function handleRegister(e) {
        e.preventDefault();
        const fullName = document.getElementById('registerName').value;
        const email = document.getElementById('registerEmail').value;
        const password = document.getElementById('registerPassword').value;
        const errorDiv = document.getElementById('registerError');
        errorDiv.style.display = 'none';

        const formData = new FormData();
        formData.append('fullName', fullName);
        formData.append('email', email);
        formData.append('password', password);

        try {
        const response = await fetch('/Account/Register', {
        method: 'POST',
        body: formData
        });
        const result = await response.json();
        if (result.success) {
        closeAuthModal();
        if (_pendingEventId) {
        openEventDetailsModal(_pendingEventId);
        _pendingEventId = null;
        } else {
        window.location.reload();
        }
        } else {
        errorDiv.innerText = result.message;
        errorDiv.style.display = 'block';
        }
        } catch (err) {
        errorDiv.innerText = 'An error occurred. Please try again.';
        errorDiv.style.display = 'block';
        }
        }

        // ===== Event Details Modal =====
        var _isAuthenticated = @(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false");

        function handleDetailsClick(eventId) {
        if (_isAuthenticated) {
        openEventDetailsModal(eventId);
        } else {
        openAuthModal('login', eventId);
        }
        }

        async function openEventDetailsModal(eventId) {
        const overlay = document.getElementById('eventDetailsOverlay');
        const content = document.getElementById('eventDetailsContent');

        // Show loading
        content.innerHTML = '<div class="event-details-loading"><div class="spinner-border text-primary" role="status"></div></div>';
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';

        try {
        const response = await fetch('/Events/DetailsJson/' + eventId);
        if (!response.ok) throw new Error('Failed to load');
        const ev = await response.json();
        renderEventDetailsModal(ev);
        } catch (err) {
        content.innerHTML = '<div class="p-4 text-center text-danger">Could not load event details.</div>';
        }
        }

        function renderEventDetailsModal(ev) {
        const content = document.getElementById('eventDetailsContent');
        const dateStr = new Date(ev.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        content.innerHTML = `
        <div class="event-details-img-wrap">
        <img src="${ev.imageUrl}" alt="${ev.title}" onerror="this.src='/images/concert_banner.png'">
        <span class="event-details-badge">${ev.category}</span>
        </div>
        <div class="event-details-body">
        <h2 class="event-details-title">${ev.title}</h2>
        <p class="event-details-desc">${ev.description}</p>
        <div class="event-details-meta">
        <div class="event-details-meta-item">
        <i class="bi bi-geo-alt-fill"></i>
        <span>${ev.location}</span>
        </div>
        <div class="event-details-meta-item">
        <i class="bi bi-calendar-event-fill"></i>
        <span>${dateStr}</span>
        </div>
        <div class="event-details-meta-item">
        <i class="bi bi-ticket-perforated-fill"></i>
        <span>${ev.ticketCount} tickets remaining</span>
        </div>
        </div>
        <div class="event-details-purchase">
        <div class="event-details-purchase-info">
        <span class="event-details-purchase-label">1 Ticket per Person</span>
        <span class="event-details-purchase-sub">Ticket will be linked to your account</span>
        </div>
        ${ev.ticketCount > 0
        ? `<form method="post" action="/Events/Buy/${ev.id}" class="d-inline">
        <button type="submit" class="event-details-buy-btn" id="buyTicketBtn-${ev.id}">
        <i class="bi bi-bag-check-fill me-2"></i>Buy Ticket
        </button>
        </form>`
        : `<button class="event-details-buy-btn disabled" disabled>
        <i class="bi bi-x-circle me-2"></i>Sold Out
        </button>`
        }
        </div>
        </div>
        `;
        }

        function closeEventDetailsModal() {
        const overlay = document.getElementById('eventDetailsOverlay');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
        }
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Footer -->
    <footer class="bg-dark text-light mt-5 py-5">
        <div class="container">
            <div class="row">
                <!-- About Section -->
                <div class="col-md-4 mb-4 mb-md-0">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-ticket-perforated me-2 text-warning"></i>EventTicketSystem
                    </h5>
                    <p class="text-light small">Your ultimate destination for booking tickets to the hottest events.
                        From concerts and theater to sports and festivals.</p>
                    </div>

                    <!-- Quick Links -->
                    <div class="col-md-4 mb-4 mb-md-0">
                        <h5 class="fw-bold mb-3">Quick Links</h5>
                        <ul class="list-unstyled small">
                            <li class="mb-2"><a href="/" class="text-light text-decoration-none">Home</a></li>
                            <li class="mb-2"><a href="/Events/Theater" class="text-light text-decoration-none">Theater</a></li>
                            <li class="mb-2"><a href="/Events/Concert" class="text-light text-decoration-none">Concerts</a></li>
                            <li class="mb-2"><a href="/Events/Cinema" class="text-light text-decoration-none">Cinema</a></li>
                            <li class="mb-2"><a href="/Events/Festival" class="text-light text-decoration-none">Festivals</a></li>
                            <li class="mb-2"><a href="/Events/Sports" class="text-light text-decoration-none">Sports</a></li>
                        </ul>
                    </div>

                    <!-- Contact Section -->
                    <div class="col-md-4">
                        <h5 class="fw-bold mb-3">Get In Touch</h5>
                        <div class="small text-light">
                            <p class="mb-2">
                                <i class="bi bi-envelope me-2"></i>
                                <a href="mailto:info@eventticketsystem.com"
                                   class="text-light">info@eventticketsystem.com</a>
                            </p>
                            <p class="mb-2">
                                <i class="bi bi-telephone me-2"></i>
                                <span>+1 (800) 123-4567</span>
                            </p>
                            <div class="mt-3">
                                <a href="javascript:void(0)" class="text-light me-3"><i class="bi bi-facebook"></i></a>
                                <a href="javascript:void(0)" class="text-light me-3"><i class="bi bi-twitter"></i></a>
                                <a href="javascript:void(0)" class="text-light"><i class="bi bi-instagram"></i></a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer Divider -->
                <hr class="border-secondary my-4">

                <!-- Footer Bottom -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <p class="text-muted small mb-0">&copy; 2026 EventTicketSystem. All rights reserved.</p>
                    <div class="small">
                        <a href="javascript:void(0)" class="text-muted text-decoration-none me-3">Privacy Policy</a>
                        <a href="javascript:void(0)" class="text-muted text-decoration-none">Terms of Service</a>
                    </div>
                </div>
            </div>
        </footer>
    </body>

</html>

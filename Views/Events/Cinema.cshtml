@model List<EventTicketSystem.Models.Event>

<!-- Cinema Banner Section -->
<div class="cinema-banner-section"
     style="background: linear-gradient(135deg, #0DCAF0 0%, #0AA2C0 100%); padding: 60px 20px; color: white; margin-bottom: 40px; border-radius: 8px; margin-top: -15px;">
    <div class="container">
        <span class="badge bg-info text-dark px-3 py-2 rounded-pill text-uppercase mb-3"
              style="letter-spacing: 1px; font-weight: 700; display: inline-block;">Big Screen</span>
        <h1 class="display-4 fw-bold mb-3">Cinema & Movies</h1>
        <p class="lead mb-0">Discover the latest blockbusters and art-house films. Reserve your seat for an
            unforgettable cinematic experience.</p>
        </div>
    </div>

    <div class="container mb-5">
        @if (Model.Any())
        {
            <div class="event-scroll-container">
                @foreach (var item in Model)
                {
                    <div class="event-card">
                        <div class="event-card-img-wrapper">
                            <span class="event-card-badge bg-info text-dark">Cinema</span>
                            <img class="event-card-img" src="@item.ImageUrl" alt="@item.Title"
                                 onerror="this.src='/images/cinema_banner.png'">
                        </div>
                        <div class="event-card-body">
                            <h3 class="event-card-title">@item.Title</h3>
                            <div class="event-card-info">
                                <i class="bi bi-geo-alt event-card-info-icon me-1"></i> @item.Location
                            </div>
                            <div class="event-card-info">
                                <i class="bi bi-calendar3 event-card-info-icon me-1"></i> @item.Date.ToString("dd MMM yyyy")
                            </div>
                            <div class="event-card-footer">
                                <span class="text-muted" style="font-size: 0.85rem; font-weight: 500;"><i
                                    class="bi bi-ticket-perforated-fill me-1"></i> @item.TicketCount left</span>
                                    <button type="button" onclick="handleDetailsClick(@item.Id)"
                                            class="btn btn-info event-card-btn text-dark">Details</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (ViewBag.TotalPages > 1)
                {
                    <nav class="mt-5" aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="/Events/Cinema?page=1">First</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="/Events/Cinema?page=@(ViewBag.CurrentPage - 1)">Previous</a>
                                </li>
                            }

                            @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage +
                    2); i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="/Events/Cinema?page=@i">@i</a>
                                </li>
                            }

                            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="/Events/Cinema?page=@(ViewBag.CurrentPage + 1)">Next</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="/Events/Cinema?page=@(ViewBag.TotalPages)">Last</a>
                                </li>
                            }
                        </ul>
                    </nav>
                    <div class="text-center mb-3">
                        <small class="text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages (Total: @ViewBag.TotalCount
                            events)</small>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        <i class="bi bi-info-circle me-2"></i>
                        No cinema screenings scheduled at the moment. Check back soon!
                    </div>
                }
            </div>

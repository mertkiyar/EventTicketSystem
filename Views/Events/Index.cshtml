@model List<EventTicketSystem.Models.Event>

<div class="container mt-5">
    <h1 class="mb-4">Upcoming Events</h1>

    <div class="row">
        @foreach (var item in Model)
        {
            var isPast = item.Date.Date.Add(item.Time.ToTimeSpan()) < DateTime.Now;
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow @(isPast ? "opacity-75 bg-light" : "")" style="@(isPast ? "filter: grayscale(100%);" : "")">
                    <img src="@item.ImageUrl" class="card-img-top" style="height: 250px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text">
                            @item.Description
                        </p>
                        <p>
                            <strong>Location:</strong> @item.Location
                        </p>
                        <p>
                            <strong>Date:</strong> @item.Date.ToString("dd MMM yyyy")
                        </p>
                        <p>
                            <strong>Tickets:</strong> @item.TicketCount
                        </p>

                        <a asp-controller="Events" asp-action="Details" asp-route-id="@item.Id" class="btn btn-dark w-100">
                            View Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
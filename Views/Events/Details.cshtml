@model EventTicketSystem.Models.Event

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <img src="@Model.ImageUrl" class="img-fluid rounded shadow">
        </div>
        <div class="col-md-6">
            <h1>@Model.Title</h1>
            <p class="mt-4">
                @Model.Description
            </p>
            <hr>
            <p>
                <strong>Location:</strong>
                @Model.Location
            </p>
            <p>
                <strong>Date:</strong>
                @Model.Date.ToString("dd MMM yyyy")
            </p>
            <p>
                <strong>Category:</strong>
                @Model.Category
            </p>
            <p>
                <strong>Remaining Tickets:</strong>
                @Model.TicketCount
            </p>
            <a asp-controller="Events" asp-action="Buy" asp-route-id="@Model.Id" class="btn btn-danger btn-lg mt-3">
                Buy Ticket
            </a>
        </div>
    </div>
</div>
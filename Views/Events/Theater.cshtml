@model List<EventTicketSystem.Models.Event>

<!-- Theater Banner Section -->
<div class="theater-banner-section"
     style="background: linear-gradient(135deg, #FFC107 0%, #FF9800 100%); padding: 60px 20px; color: white; margin-bottom: 40px; border-radius: 8px; margin-top: -15px;">
    <div class="container">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill text-uppercase mb-3"
              style="letter-spacing: 1px; font-weight: 700; display: inline-block;">Classic & Modern</span>
        <h1 class="display-4 fw-bold mb-3">Theater Plays</h1>
        <p class="lead mb-0">Experience majestic theatrical performances from classic tragedies to modern Broadway hits.
            Reserve your stage front seats today.</p>
        </div>
    </div>

    <div class="container mb-5">
        @if (Model.Any())
        {
            <div class="event-scroll-container">
                @foreach (var item in Model)
                {
                    <div class="event-card">
                        <div class="event-card-img-wrapper">
                            <span class="event-card-badge bg-warning text-dark">Theater</span>
                            <img class="event-card-img" src="@item.ImageUrl" alt="@item.Title"
                                 onerror="this.src='/images/theater_banner.png'">
                        </div>
                        <div class="event-card-body">
                            <h3 class="event-card-title">@item.Title</h3>
                            <div class="event-card-info">
                                <i class="bi bi-geo-alt event-card-info-icon me-1"></i> @item.Location
                            </div>
                            <div class="event-card-info">
                                <i class="bi bi-calendar3 event-card-info-icon me-1"></i> @item.Date.ToString("dd MMM yyyy")
                            </div>
                            <div class="event-card-footer">
                                <span class="text-muted" style="font-size: 0.85rem; font-weight: 500;"><i
                                    class="bi bi-ticket-perforated-fill me-1"></i> @item.TicketCount left</span>
                                    <button type="button" onclick="handleDetailsClick(@item.Id)"
                                            class="btn btn-warning event-card-btn text-dark">Details</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
    else
            {
                <div class="alert alert-info" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    No theater plays scheduled at the moment. Check back soon!
                </div>
            }
        </div>

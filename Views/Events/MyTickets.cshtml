@model List<EventTicketSystem.Models.Ticket>
@{
    ViewData["Title"] = "My Tickets";
}

<div class="container mt-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="my-tickets-header mb-4">
        <h1 class="my-tickets-title"><i class="bi bi-ticket-perforated-fill me-2"></i>My Tickets</h1>
        <p class="text-muted">All tickets linked to your account</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="my-tickets-empty">
            <i class="bi bi-ticket-perforated my-tickets-empty-icon"></i>
            <h3>No tickets yet</h3>
            <p class="text-muted">Browse events and get your first ticket!</p>
            <a href="/" class="btn btn-dark rounded-pill px-4 py-2 mt-2">
                <i class="bi bi-search me-2"></i>Explore Events
            </a>
        </div>
    }
    else
    {
        <div class="my-tickets-grid">
            @foreach (var ticket in Model)
            {
                <div class="my-ticket-card" style="@(ticket.Status == "Cancelled" ? "opacity: 0.6;" : "")">
                    <div class="my-ticket-img-wrap">
                        <img src="@ticket.Event.ImageUrl" alt="@ticket.Event.Title"
                             onerror="this.src='/images/concert_banner.png'">
                        <span class="my-ticket-category-badge">@ticket.Event.Category</span>
                        @if (ticket.Status == "Cancelled")
                        {
                            <div
                                style="position: absolute; top: 10px; right: 10px; background: rgba(220, 53, 69, 0.9); color: white; padding: 8px 12px; border-radius: 6px; font-weight: bold; font-size: 0.85rem;">
                                CANCELLED
                            </div>
                        }
                    </div>
                    <div class="my-ticket-body">
                        <h3 class="my-ticket-event-title">@ticket.Event.Title</h3>
                        <div class="my-ticket-meta">
                            <div class="my-ticket-meta-row">
                                <i class="bi bi-geo-alt-fill"></i>
                                <span>@ticket.Event.Location</span>
                            </div>
                            <div class="my-ticket-meta-row">
                                <i class="bi bi-calendar-event-fill"></i>
                                <span>@ticket.Event.Date.ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="my-ticket-meta-row">
                                <i class="bi bi-person-fill"></i>
                                <span>@ticket.CustomerName</span>
                            </div>
                            <div class="my-ticket-meta-row">
                                <i class="bi bi-envelope-fill"></i>
                                <span>@ticket.CustomerEmail</span>
                            </div>
                        </div>
                        <div class="my-ticket-footer">
                            <div class="my-ticket-id">
                                <span class="text-muted" style="font-size:0.75rem;">Ticket ID</span>
                                <span class="fw-bold">#@ticket.Id.ToString("D6")</span>
                            </div>
                            <div class="my-ticket-date">
                                <span class="text-muted" style="font-size:0.75rem;">Purchased</span>
                                <span>@ticket.PurchaseDate.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                        @if (ticket.Status == "Active")
                        {
                            <div class="mt-3">
                                <form method="post" asp-action="CancelTicket" asp-route-ticketId="@ticket.Id"
                                      style="display: inline;">
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('Cancel this ticket?')">
                                        <i class="bi bi-x-circle me-1"></i> Cancel Ticket
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                    <div class="my-ticket-barcode">
                        <div class="barcode-lines"></div>
                        <span class="barcode-text">TKT-@ticket.Id.ToString("D8")</span>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-4 mb-5">
            <a href="/" class="btn btn-outline-dark rounded-pill px-4 py-2">
                <i class="bi bi-plus-circle me-2"></i>Get More Tickets
            </a>
        </div>
    }
</div>
